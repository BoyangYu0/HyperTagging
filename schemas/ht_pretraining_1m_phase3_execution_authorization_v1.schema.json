{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ht-pretraining-1m-phase3-execution-authorization-v1",
  "title": "HyperTagging production-1M phase-3 execution authorization",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_version",
    "artifact_sha256",
    "authorization_basis",
    "timestamp",
    "submission_authorized",
    "submission_performed",
    "gpu_pilot_completed",
    "fresh_in_allocation_preflight_required",
    "execution_role_required",
    "sealed_test_or_stress_payload_accessed",
    "structural_scientific_slurm_submission_allowed",
    "immutable_parent_hashes",
    "immutable_parent_files",
    "exact_bindings",
    "retained_gates",
    "provenance_exception"
  ],
  "properties": {
    "artifact_version": {
      "const": "ht-pretraining-1m-phase3-execution-authorization-v1"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_basis": {
      "const": "explicit_user_operator_instruction"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "submission_authorized": { "const": true },
    "submission_performed": { "const": false },
    "gpu_pilot_completed": { "const": false },
    "fresh_in_allocation_preflight_required": { "const": true },
    "execution_role_required": {
      "const": "gpt-5.3-codex-spark medium"
    },
    "sealed_test_or_stress_payload_accessed": { "const": false },
    "structural_scientific_slurm_submission_allowed": { "const": false },
    "immutable_parent_hashes": { "type": "object" },
    "immutable_parent_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "exact_bindings": { "type": "object" },
    "retained_gates": { "type": "object" },
    "provenance_exception": { "type": "object" }
  }
}
